# ============================================================================
#  Rathod Brothers — environment template
#
#  Copy to `.env` and fill in real values.  NEVER commit a filled-in `.env`.
#
#    cp .env.example .env
#
#  Only the server reads these. The client only ever sees VITE_* values, and the
#  only VITE_* value used is VITE_API_BASE_URL (a URL, never a secret).
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Public origin of the website. Used for CORS allow-listing and for building
# absolute URLs (sitemap, JSON-LD). Comma-separate to allow several origins.
CLIENT_ORIGIN=http://localhost:5173

# --- Database (MySQL 8) ----------------------------------------------------
# DATABASE_URL is optional. If set it takes precedence over the discrete
# fields below, in the form:  mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rathod_brothers
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# --- Auth -------------------------------------------------------------------
# REQUIRED in production. Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot in production if this is missing or is one of the
# known placeholder values below.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Password hash cost. 10-14; higher is slower and stronger. Above 14 is
# discouraged because bcryptjs is pure JavaScript.
BCRYPT_ROUNDS=12

# --- Seed admin (used by `npm run db:seed` only) ----------------------------
# Creates the first /admin login. Change the password before going live.
SEED_ADMIN_NAME=Rathod Brothers Admin
SEED_ADMIN_EMAIL=admin@rathodbrothers.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!

# --- Client (Vite) ----------------------------------------------------------
# Leave empty in production when the API and site share an origin, because the
# client then calls same-origin "/api" and the Express server serves the built
# frontend from client/dist.
VITE_API_BASE_URL=
