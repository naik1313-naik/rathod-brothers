# ---- dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---- build output -----------------------------------------------------------
dist/
build/
*.tsbuildinfo

# ---- environment ------------------------------------------------------------
# .env holds real secrets (JWT signing key, database password, seeded admin
# password). It must never be committed — .env.example is the committed template.
.env
.env.*
!.env.example

# ---- logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- test / coverage output -------------------------------------------------
coverage/
.nyc_output/

# ---- editor & OS ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- local MySQL data directory ---------------------------------------------
database/mysql-data/

# ---- caches -----------------------------------------------------------------
.vite/
.cache/
.eslintcache
